{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git clone --depth 1 --branch 3.50.0 https://github.com/flutter/flutter.git /tmp/flutter",
  "buildCommand": "/tmp/flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
